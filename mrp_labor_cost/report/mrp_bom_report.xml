<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. PDF REPORT — inherits mrp.report_bom_structure -->
    <template id="report_bom_structure_labor_cost"
              inherit_id="mrp.report_bom_structure">

        <!-- Add Labor Cost column header -->
        <xpath expr="//thead//th[last()]" position="after">
            <th class="text-right">İşçilik (₺)</th>
        </xpath>

        <!-- Add labor_cost value to each BOM line row -->
        <xpath expr="//tr[hasclass('o_bom_report_line')]/td[last()]"
               position="after">
            <td class="text-right">
                <t t-esc="'%.2f' % (line.get('labor_cost') or 0.0)"/>
            </td>
        </xpath>

    </template>

    <!-- 2. PDF COST SUMMARY — adds Labor Cost row next to BoM Cost -->
    <template id="report_bom_structure_labor_cost_totals"
              inherit_id="mrp.report_bom_structure">

        <xpath expr="//tr[hasclass('o_bom_report_line_unit_price')]"
               position="before">
            <t t-if="data.get('labor_cost')">
                <tr class="o_bom_report_line_labor_cost">
                    <td colspan="5">
                        <strong>İşçilik (₺)</strong>
                    </td>
                    <td class="text-right" colspan="2">
                        <strong>
                            <t t-esc="'%.2f' % (data.get('labor_cost') or 0.0)"/>
                        </strong>
                    </td>
                </tr>
            </t>
        </xpath>

    </template>

</odoo>
