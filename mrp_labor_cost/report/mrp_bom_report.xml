<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        1. PDF RAPORU — TABLO BAŞLIĞI
        Asıl tablo mrp.report_mrp_bom template'inde yer alır.
        BoM Maliyeti ve Ürün Maliyeti başlıklarından sonra İşçilik (₺) ekleniyor.
    -->
    <template id="report_bom_structure_labor_cost_header"
              inherit_id="mrp.report_mrp_bom">
        <xpath expr="//thead/tr/th[last()]" position="after">
            <th t-if="data['show_costs']" class="text-end">İşçilik (₺)</th>
        </xpath>
    </template>

    <!--
        2. PDF RAPORU — SATIR DEĞERLERİ
        Her BOM satırı mrp.report_mrp_bom_pdf_line ile render edilir.
        Satırdaki son td'den sonra o reçetenin labor_cost değeri ekleniyor.
    -->
    <template id="report_bom_structure_labor_cost_line"
              inherit_id="mrp.report_mrp_bom_pdf_line">
        <xpath expr="//tr/td[last()]" position="after">
            <td t-if="data['show_costs']" class="text-end">
                <t t-esc="'%.2f' % (l.get('labor_cost') or 0.0)"/>
            </td>
        </xpath>
    </template>

</odoo>
