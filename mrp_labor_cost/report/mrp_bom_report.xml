<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        PDF RAPORU — mrp.report_mrp_bom inherit edilir.
        "Unit Cost" satırının (td_mrp_bom_f) hemen altına
        İşçilik Maliyeti satırı eklenir.
        Kolon yaklaşımı kullanılmaz; bileşen satırlarına dokunulmaz.
    -->
    <template id="report_bom_structure_labor_cost"
              inherit_id="mrp.report_mrp_bom">

        <xpath expr="//tr[td[@name='td_mrp_bom_f']]" position="after">
            <tr t-if="data['show_costs'] and data.get('labor_cost')">
                <td name="td_mrp_bom_labor"/>
                <td class="text-end"><strong>İşçilik Maliyeti</strong></td>
                <td groups="uom.group_uom"/>
                <td t-if="data['show_availabilities']"/>
                <td t-if="data['show_availabilities']"/>
                <td t-if="data['show_availabilities']"/>
                <td t-if="data['show_lead_times']"/>
                <td/>
                <td class="text-end"
                    t-esc="data['labor_cost']"
                    t-options='{"widget": "monetary", "display_currency": currency}'/>
                <td/>
            </tr>
        </xpath>

    </template>

</odoo>
