<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Odoo 16 "Genel Bakış" butonu mrp.BomOverview OWL bileşenini açar.
        QWeb template değil OWL template inheritance kullanılır.
        İşçilik (₺) kolonu BoM Maliyeti kolonunun yanına ayrı bir kolon olarak eklenir.
    -->
    <t t-inherit="mrp.BomOverview" t-inherit-mode="extension">

        <!-- Tablo başlığına İşçilik (₺) kolonu ekleniyor (BoM Maliyeti'nin ardına) -->
        <xpath expr="//th[hasclass('o_bom_overview_bom_cost')]" position="after">
            <th class="text-end">İşçilik (₺)</th>
        </xpath>

        <!-- Her satırda BoM Maliyeti'nin ardına iscilik_tutari değeri ekleniyor -->
        <xpath expr="//td[hasclass('o_bom_overview_bom_cost')]" position="after">
            <td class="text-end">
                <t t-if="line.iscilik_tutari">
                    <t t-esc="line.iscilik_tutari.toFixed(2)"/>
                </t>
                <t t-else="">-</t>
            </td>
        </xpath>

    </t>

</templates>
