<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Extends mrp.BomOverview OWL component (Overview button) -->
    <t t-inherit="mrp.BomOverview" t-inherit-mode="extension">

        <!-- Add Labor Cost column header after BoM Cost -->
        <xpath expr="//th[hasclass('o_bom_overview_bom_cost')]" position="after">
            <th class="text-end">Labor Cost (₺)</th>
        </xpath>

        <!-- Add labor_cost value in each row after BoM Cost cell -->
        <xpath expr="//td[hasclass('o_bom_overview_bom_cost')]" position="after">
            <td class="text-end">
                <t t-if="line.labor_cost">
                    <t t-esc="line.labor_cost.toFixed(2)"/>
                </t>
                <t t-else="">-</t>
            </td>
        </xpath>

    </t>

</templates>
