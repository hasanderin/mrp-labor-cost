<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="mrp.BomOverviewTable" t-inherit-mode="extension">

        <!-- 1. İşçilik Maliyeti satırını tfoot'tan önce ekle -->
        <xpath expr="//tfoot" position="before">
            <tbody t-if="showCosts and data.labor_cost">
                <tr class="table-info">
                    <td class="fw-bold">İşçilik Maliyeti</td>
                    <td/>
                    <td t-if="showUom"/>
                    <td t-if="showAvailabilities"/>
                    <td t-if="showAvailabilities"/>
                    <td t-if="showAvailabilities"/>
                    <td t-if="showLeadTimes"/>
                    <td/>
                    <td class="text-end fw-bold" t-esc="formatMonetary(data.labor_cost)"/>
                    <td/>
                    <td t-if="showAttachments"/>
                </tr>
            </tbody>
        </xpath>

        <!-- 2. Birim Maliyeti satırında BoM Maliyetine işçiliği dahil et -->
        <xpath expr="//tfoot/tr/td[@t-esc='formatMonetary(data.bom_cost / data.quantity)']"
               position="replace">
            <td class="text-end"
                t-esc="formatMonetary((data.bom_cost + (data.labor_cost || 0)) / data.quantity)"/>
        </xpath>

    </t>

</templates>
