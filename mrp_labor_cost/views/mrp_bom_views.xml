<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_bom_form_view_labor_cost" model="ir.ui.view">
        <field name="name">mrp.bom.form.labor.cost</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <!--
                product_uom_id (Birim) alanının hemen ardına İşçilik (₺) ekleniyor.
                Odoo 16 BOM form view'da grup XPath güvenilir olmadığından
                alan bazlı XPath kullanılır.
            -->
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="iscilik_tutari" string="İşçilik (₺)"/>
            </xpath>
        </field>
    </record>

</odoo>
