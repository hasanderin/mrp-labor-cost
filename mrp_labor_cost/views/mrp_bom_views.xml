<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_bom_form_view_labor_cost" model="ir.ui.view">
        <field name="name">mrp.bom.form.labor.cost</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <!--
                product_qty ve product_uom_id bir <div class="o_row"> içinde.
                O div'den sonra labor_cost kendi satırında görünür.
            -->
            <xpath expr="//div[hasclass('o_row')][field[@name='product_qty']]" position="after">
                <field name="labor_cost" string="İşçilik (₺)"/>
            </xpath>
        </field>
    </record>

</odoo>
