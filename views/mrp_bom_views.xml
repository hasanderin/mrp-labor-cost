<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_bom_form_view_labor_cost" model="ir.ui.view">
        <field name="name">mrp.bom.form.labor.cost</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <!--
                product_qty alanının bulunduğu grubun hemen altına
                İşçilik (₺) alanını yeni bir grup olarak ekliyoruz.
            -->
            <xpath expr="//group[field[@name='product_qty']]" position="after">
                <group string="İşçilik">
                    <field name="iscilik_tutari" string="İşçilik (₺)"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
